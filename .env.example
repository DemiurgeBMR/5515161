# Скопируй этот файл в .env и заполни реальными значениями.
# .env в .gitignore — в репозиторий не попадёт.

# --- База данных ---
DB_NAME=riveg_rent
DB_USER=riveg_rent
DB_PASS=
DB_ROOT_PASS=

# --- Сайт ---
# Публичный адрес сайта — используется в письмах, sitemap.xml, og:url.
SITE_URL=http://localhost:8080
APP_TIMEZONE=Europe/Moscow
DEBUG_MODE=false

# --- Почта (SMTP) ---
# Пусто = письма не отправляются реально (ссылки показываются на экране,
# см. config.php). Заполни, когда появится реальный почтовый провайдер.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ENCRYPTION=tls
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=
# Контактный email в политике обработки данных и пользовательском соглашении.
# Пусто = no-reply@riveg-rent.ru.
CONTACT_EMAIL=
# Телефон и реквизиты продавца для документов и подвала сайта. Пусто = значения по умолчанию из config.php.
CONTACT_PHONE=
OPERATOR_NAME=
OPERATOR_INN=
OPERATOR_OGRNIP=
OPERATOR_ADDRESS=

# --- Оплата (ЮKassa) ---
# Пусто = покупки на сайте отключены. Ключи — в личном кабинете ЮKassa
# (Интеграция → Ключи API). В ЮKassa также укажите адрес уведомлений:
# https://ВАШ-ДОМЕН/api/yookassa_webhook.php (события payment.succeeded и payment.canceled).
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Чек по 54-ФЗ уходит в ЮKassa вместе с платежом. Для ИП на УСН ничего менять
# не нужно (по умолчанию: чеки включены, «Без НДС»). Остальное — по необходимости:
# YOOKASSA_SEND_RECEIPT=false  — не передавать чек (самозанятый, НПД; тогда поправьте
#                                тексты про чек в terms.php, privacy_policy.php, subscription.php);
# YOOKASSA_VAT_CODE=1          — ставка НДС: 1 без НДС (остальные коды — в документации ЮKassa);
# YOOKASSA_TAX_SYSTEM_CODE=2   — система налогообложения: 1 ОСН, 2 УСН «доходы»,
#                                3 УСН «доходы минус расходы», 6 патент (нужна, только
#                                если в магазине ЮKassa включено несколько систем).
YOOKASSA_SEND_RECEIPT=
YOOKASSA_VAT_CODE=
YOOKASSA_TAX_SYSTEM_CODE=

# --- Прочее ---
TRUSTED_PROXY_IPS=
APP_PORT=8080

# Путь к твоему экспорту данных городов (phpMyAdmin → _cities/_countries/_regions,
# "только данные"), для docker compose --profile seed run --rm seed-cities.
# CITIES_DUMP_PATH=./database/seed/cities.sql
