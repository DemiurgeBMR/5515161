# Не показывать содержимое папок без index-файла (например uploads/locations/) —
# по умолчанию Apache перечисляет файлы внутри, это ненужная утечка.
Options -Indexes

# config.php — только для require из других PHP-файлов, не самостоятельная
# страница (открытый напрямую, он ничего не показывает, но и незачем этому
# отвечать 200 OK). require/include читают файл с диска напрямую, это
# правило действует только на HTTP-запросы и сайт не затрагивает.
<Files "config.php">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</Files>
