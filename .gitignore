# Файлы, которые загружают пользователи во время работы сайта — не часть
# кода, не должны попадать в git: раздувают историю репозитория и могут
# утечь чужие фотографии, если код когда-нибудь станет публичным. Каталоги
# создаются приложением на лету (mkdir с recursive=true), placeholder-файлы
# не нужны. Исключение — .htaccess: это часть кода (запрещает исполнение
# скриптов в папке с чужими файлами), а не загруженный контент, и должен
# доезжать до продакшена вместе с остальным репозиторием.
/public_html/uploads/*
!/public_html/uploads/.htaccess

# Файловый кеш (геокодинг, рекомендации и т.п.) — генерируется на лету,
# каждая установка накапливает свой.
/cache/*

# Типичный мусор редакторов и ОС
.DS_Store
Thumbs.db
.idea/
.vscode/
